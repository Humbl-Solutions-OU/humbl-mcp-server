{
  "name": "@humblai/mcp-server",
  "version": "2.0.1",
  "description": "MCP server for Humbl.ai intelligence data: adverts, toplists, rankings, games",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test src/*.test.ts",
    "start:http": "node dist/http-main.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "humbl",
    "advert",
    "ppc",
    "toplists",
    "rankings",
    "igaming"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "bin": {
    "mcp-server": "dist/index.js",
    "humbl-mcp-server": "dist/index.js",
    "humbl-mcp-http": "dist/http-main.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Humbl-Solutions-OU/humbl-mcp-server.git"
  }
}
